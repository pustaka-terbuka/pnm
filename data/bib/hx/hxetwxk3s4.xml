    <marc:datafield tag="245" ind1="0" ind2="0">
      <marc:subfield code="a">[Kitab fikah]</marc:subfield>
    </marc:datafield>
    <marc:datafield tag="264" ind1=" " ind2="1">
      <marc:subfield code="c">1600-1970</marc:subfield>
    </marc:datafield>
    <marc:datafield tag="520" ind1=" " ind2=" ">
      <marc:subfield code="a">Membicarakan ilmu fikah yang disampaikan didalam beberapa bab. Antaranya bab qada hajat dan istinjak, bab sembahyang, bab mengenai syarat-syarat mengikut imam, bab mengenai memandikan mayat, bab akikah dan bab mengenai makanan yang halal dan haram dimakan.</marc:subfield>
    </marc:datafield>
    <marc:datafield tag="520" ind1=" " ind2=" ">
      <marc:subfield code="a">Mengandungi perkara-perkara berkaitan dengan fikah seperti syarat sah wuduk dengan huraian dan dalil</marc:subfield>
    </marc:datafield>
