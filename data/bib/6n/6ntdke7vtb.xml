    <marc:datafield tag="245" ind1="0" ind2="0">
      <marc:subfield code="a">[Pelbagai catatan]</marc:subfield>
    </marc:datafield>
    <marc:datafield tag="264" ind1=" " ind2="1">
      <marc:subfield code="c">1600-1900</marc:subfield>
    </marc:datafield>
    <marc:datafield tag="520" ind1=" " ind2=" ">
      <marc:subfield code="a">Mengandungi pelbagai catatan terutamanya mengenai ilmu fikahserta mengenai tauhid dan tasawuf. Antara lain yang dicatatkan ialah mengenai zakat, wuduk, cara menguruskan mayat,hukum nazar, fadilat Surah al-Fatihah, Sembahyang terawih, sifat 20, hadis 40 dan juga mengenai perkara-perkara yang terjadi ketika sakarat al-mawt.</marc:subfield>
    </marc:datafield>
    <marc:datafield tag="520" ind1=" " ind2=" ">
      <marc:subfield code="a">Antara lain catatan mengenai sakaratul maut, adab berzikir dan masalah berkaitan wali nikah dan berkhatan. Catatan banyak menggunakan bahasa Arab</marc:subfield>
    </marc:datafield>
